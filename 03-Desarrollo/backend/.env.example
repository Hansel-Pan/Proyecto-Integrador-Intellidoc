PROJECT_NAME=IntelliDoc
VERSION=0.1.0
API_V1_STR=/api/v1

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# MySQL Configuration
DATABASE_URL=mysql+pymysql://usuario:contraseña@host:3306/base_de_datos
CHROMADB_PATH=./chroma_db

SECRET_KEY=genera_una_clave_segura_de_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Gemini AI Configuration
# Proveedor: gemini, openai o anthropic (tambien acepta claude)
LLM_PROVIDER=gemini
LLM_API_KEY=tu_api_key_del_proveedor
LLM_MODEL=gemini-flash-latest
# Solo necesario para OpenAI-compatible; dejar vacio para OpenAI oficial
LLM_BASE_URL=

EMBEDDING_MODEL=all-MiniLM-L6-v2

MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=["pdf","docx","txt"]

CLEVER_TOKEN=solo_si_usas_la_cli_de_clever_cloud
CLEVER_SECRET=solo_si_usas_la_cli_de_clever_cloud